{
  "name": "daeuniverse-linux-repository-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:test": "npm run docs:prepare && node --test tests/*.test.mjs",
    "docs:prepare": "npm run docs:fetch && node scripts/prepare-docs.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev docs",
    "docs:build": "npm run docs:prepare && vitepress build docs && npm run docs:check-anchors",
    "docs:check-anchors": "node scripts/check-docs-anchors.mjs",
    "docs:preview": "vitepress preview docs",
    "docs:fetch": "node scripts/fetch-docs.mjs"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  },
  "engines": { "node": ">=22" }
}
